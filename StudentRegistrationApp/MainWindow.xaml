<Window x:Class="StudentRegistrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Registration"
        Height="820"
        Width="1180"
        MinHeight="700"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Foreground="#E2E8F0">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#070A18" Offset="0"/>
            <GradientStop Color="#0B1122" Offset="0.55"/>
            <GradientStop Color="#140E2C" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>

        <!-- ==================== WARNA ==================== -->
        <SolidColorBrush x:Key="Accent" Color="#38E8FF"/>
        <SolidColorBrush x:Key="InputBg" Color="#0A101F"/>
        <SolidColorBrush x:Key="InputBorder" Color="#243250"/>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#06B6D4" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="1"/>
        </LinearGradientBrush>

        <!-- ==================== TEKS ==================== -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8B9BB8"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
        </Style>

        <!-- ==================== KARTU ==================== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#D90D1426"/>
            <Setter Property="CornerRadius" Value="22"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5538E8FF" Offset="0"/>
                        <GradientStop Color="#22FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#557C3AED" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== TEXTBOX ==================== -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="CaretBrush" Value="#38E8FF"/>
            <Setter Property="SelectionBrush" Value="#0891B2"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B5B8A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38E8FF"/>
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#38E8FF" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== DATEPICKER ==================== -->
        <Style x:Key="DarkDateTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="#38E8FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Bd"
                                Background="{StaticResource InputBg}"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   Style="{StaticResource DarkDateTextBox}"/>

                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Width="40"
                                        Focusable="False"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <TextBlock Text="&#xE787;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="15"
                                                           Foreground="#38E8FF"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       AllowsTransparency="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38E8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== COMBOBOX ==================== -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{StaticResource InputBg}"
                    BorderBrush="{StaticResource InputBorder}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Path Data="M 0 0 L 5 5 L 10 0"
                      Stroke="#38E8FF"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,14,0"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#3B5B8A"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="#38E8FF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="8"
                                Margin="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B2A47"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F3B4C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboToggleTemplate}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>

                            <TextBlock x:Name="Placeholder"
                                       Text="Pilih program studi"
                                       Foreground="#5B6B88"
                                       Margin="14,0,38,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>

                            <ContentPresenter IsHitTestVisible="False"
                                              Margin="14,0,38,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,6,0,0"
                                        Background="#0D1426"
                                        BorderBrush="#38E8FF"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="4">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="SelectedIndex" Value="-1">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== RADIOBUTTON ==================== -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{StaticResource InputBg}"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="20,10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B5B8A"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F3B4C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38E8FF"/>
                                <Setter Property="Foreground" Value="#67E8F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== TOMBOL ==================== -->
        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.85"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#38E8FF" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#3B4A63"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B2A47"/>
                    <Setter Property="BorderBrush" Value="#38E8FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Foreground" Value="#FB7185"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#F43F5E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33F43F5E"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#F43F5E" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== LISTBOX ==================== -->
        <Style x:Key="DarkListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="#0A101F"
                                BorderBrush="#1B2842"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3B5B8A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0C2A3A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#38E8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkListBoxItem}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- Cahaya dekoratif di latar belakang -->
        <Ellipse Width="640"
                 Height="640"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-240,-280,0,0"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3038E8FF" Offset="0"/>
                    <GradientStop Color="#0038E8FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="700"
                 Height="700"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-260,-300"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#337C3AED" Offset="0"/>
                    <GradientStop Color="#007C3AED" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= JUDUL ================= -->
            <TextBlock Grid.Row="0"
                       Text="Student Registration"
                       FontFamily="Bahnschrift, Segoe UI"
                       FontSize="36"
                       FontWeight="Bold"
                       Margin="4,0,0,22">
                <TextBlock.Foreground>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#67E8F9" Offset="0"/>
                        <GradientStop Color="#A78BFA" Offset="1"/>
                    </LinearGradientBrush>
                </TextBlock.Foreground>
            </TextBlock>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>

                <!-- ================= KARTU FORM ================= -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Form pendaftaran"
                                   Style="{StaticResource SectionTitle}"
                                   Margin="0,0,0,20"/>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,0">

                                <TextBlock Text="NIM" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNim"
                                         Height="40"
                                         Margin="0,0,0,16"/>

                                <TextBlock Text="Nama mahasiswa" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtNama"
                                         Height="40"
                                         Margin="0,0,0,16"/>

                                <TextBlock Text="Program studi" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="cmbProdi"
                                          Height="40"
                                          Margin="0,0,0,16">
                                    <ComboBoxItem Content="Teknik Informatika"/>
                                    <ComboBoxItem Content="Sistem Informasi"/>
                                    <ComboBoxItem Content="Manajemen"/>
                                    <ComboBoxItem Content="Akuntansi"/>
                                </ComboBox>

                                <TextBlock Text="Jenis kelamin" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,16">
                                    <RadioButton x:Name="rbLaki" Content="Laki-laki"/>
                                    <RadioButton x:Name="rbPerempuan" Content="Perempuan"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Tanggal lahir" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker x:Name="dpTanggalLahir"
                                                    Height="40"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nomor telepon" Style="{StaticResource FieldLabel}"/>
                                        <TextBox x:Name="txtTelepon"
                                                 Height="40"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Alamat" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="txtAlamat"
                                         Height="80"
                                         Padding="12,10"
                                         VerticalContentAlignment="Top"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    Margin="0,20,0,0">
                            <Button x:Name="btnSimpan"
                                    Content="Simpan"
                                    Width="150"
                                    Height="46"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnSimpan_Click"/>
                            <Button Content="Reset"
                                    Width="110"
                                    Height="46"
                                    Style="{StaticResource GhostButton}"
                                    Click="BtnReset_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= KARTU DATA ================= -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock Text="Data mahasiswa"
                                       Style="{StaticResource SectionTitle}"
                                       VerticalAlignment="Center"/>

                            <Border HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="#0F3B4C"
                                    BorderBrush="#1F6F85"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14,5">
                                <TextBlock x:Name="txtJumlah"
                                           Text="Jumlah Mahasiswa: 0"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#67E8F9"/>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="1" Margin="0,0,0,16">
                            <TextBlock Text="Cari berdasarkan NIM, nama, atau prodi"
                                       Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtSearch"
                                     Height="40"
                                     TextChanged="TxtSearch_TextChanged"/>
                        </StackPanel>

                        <ListBox Grid.Row="2" x:Name="lstMahasiswa">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="46"
                                                Height="46"
                                                CornerRadius="23"
                                                Margin="0,0,16,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource AccentGradient}">
                                            <TextBlock Text="{Binding Inisial}"
                                                       FontFamily="Bahnschrift, Segoe UI"
                                                       FontSize="20"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Nama}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F1F5F9"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Nim}"
                                                           FontFamily="Consolas"
                                                           FontSize="13"
                                                           Foreground="#38E8FF"
                                                           Margin="0,0,12,0"/>
                                                <TextBlock Text="{Binding Prodi}"
                                                           FontSize="13"
                                                           Foreground="#A5B4CC"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding JenisKelamin}"
                                                           FontSize="12"
                                                           Foreground="#6B7C99"
                                                           Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding TanggalLahir, StringFormat={}{0:dd MMM yyyy}}"
                                                           FontSize="12"
                                                           Foreground="#6B7C99"
                                                           Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding NoTelepon}"
                                                           FontSize="12"
                                                           Foreground="#6B7C99"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    Margin="0,20,0,0">
                            <Button Content="Edit"
                                    Width="130"
                                    Height="46"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource GhostButton}"
                                    Click="BtnEdit_Click"/>
                            <Button Content="Hapus"
                                    Width="130"
                                    Height="46"
                                    Style="{StaticResource DangerButton}"
                                    Click="BtnHapus_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>