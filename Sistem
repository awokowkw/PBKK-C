using System;
using System.Collections.Generic;
using System.Globalization;

namespace DataMahasiswa
{
    class Mahasiswa
    {
        public string NIM { get; set; }
        public string Nama { get; set; }
        public string Prodi { get; set; }
        public double IPK { get; set; }

        public Mahasiswa(string nim, string nama, string prodi, double ipk)
        {
            NIM = nim;
            Nama = nama;
            Prodi = prodi;
            IPK = ipk;
        }
    }

    class Program
    {
        static List<Mahasiswa> daftarMahasiswa =
            new List<Mahasiswa>();

        static void Main(string[] args)
        {
            int pilihan;

            do
            {
                TampilkanMenu();

                Console.Write("Pilihan: ");
                string input = Console.ReadLine();

                if (!int.TryParse(input, out pilihan))
                {
                    pilihan = 0;
                }

                Console.WriteLine();

                switch (pilihan)
                {
                    case 1:
                        TambahMahasiswa();
                        break;

                    case 2:
                        TampilkanMahasiswa();
                        break;

                    case 3:
                        CariMahasiswa();
                        break;

                    case 4:
                        HapusMahasiswa();
                        break;

                    case 5:
                        Console.WriteLine(
                            "Terima kasih telah menggunakan program."
                        );
                        break;

                    default:
                        Console.WriteLine(
                            "Pilihan tidak tersedia!"
                        );
                        break;
                }

                if (pilihan != 5)
                {
                    Console.WriteLine();
                    Console.WriteLine(
                        "Tekan ENTER untuk melanjutkan..."
                    );
                    Console.ReadLine();
                }

            } while (pilihan != 5);
        }

        static void TampilkanGaris()
        {
            Console.WriteLine(
                "========================================"
            );
        }

        static void TampilkanMenu()
        {
            Console.Clear();

            TampilkanGaris();
            Console.WriteLine("       SISTEM DATA MAHASISWA");
            TampilkanGaris();

            Console.WriteLine("1. Tambah Mahasiswa");
            Console.WriteLine("2. Tampilkan Mahasiswa");
            Console.WriteLine("3. Cari Mahasiswa");
            Console.WriteLine("4. Hapus Mahasiswa");
            Console.WriteLine("5. Keluar");

            TampilkanGaris();
        }

        static void TambahMahasiswa()
        {
            Console.Clear();

            TampilkanGaris();
            Console.WriteLine("        TAMBAH MAHASISWA");
            TampilkanGaris();

            string nim;

            while (true)
            {
                Console.Write("NIM : ");
                nim = Console.ReadLine();

                if (!string.IsNullOrWhiteSpace(nim))
                {
                    break;
                }

                Console.WriteLine("NIM tidak boleh kosong.");
            }

            string nama;

            while (true)
            {
                Console.Write("Nama : ");
                nama = Console.ReadLine();

                if (!string.IsNullOrWhiteSpace(nama))
                {
                    break;
                }

                Console.WriteLine("Nama tidak boleh kosong.");
            }

            string prodi;

            while (true)
            {
                Console.Write("Program Studi : ");
                prodi = Console.ReadLine();

                if (!string.IsNullOrWhiteSpace(prodi))
                {
                    break;
                }

                Console.WriteLine(
                    "Program studi tidak boleh kosong."
                );
            }

            double ipk;

            while (true)
            {
                Console.Write("IPK : ");

                if (double.TryParse(
                    Console.ReadLine(),
                    NumberStyles.Float,
                    CultureInfo.InvariantCulture,
                    out ipk))
                {
                    if (ipk >= 0 && ipk <= 4)
                    {
                        break;
                    }
                }

                Console.WriteLine("IPK harus berupa angka 0.00 - 4.00.");
            }

            Mahasiswa mahasiswa = new Mahasiswa(
                nim,
                nama,
                prodi,
                ipk
            );

            daftarMahasiswa.Add(mahasiswa);

            Console.WriteLine();
            Console.WriteLine(
                "Data mahasiswa berhasil ditambahkan."
            );
        }

        static void TampilkanMahasiswa()
        {
            Console.Clear();

            TampilkanGaris();
            Console.WriteLine("        DAFTAR MAHASISWA");
            TampilkanGaris();

            if (daftarMahasiswa.Count == 0)
            {
                Console.WriteLine(
                    "Belum ada data mahasiswa."
                );

                return;
            }

            Console.WriteLine(
                "{0,-12} {1,-20} {2,-20} {3,5}",
                "NIM",
                "Nama",
                "Prodi",
                "IPK"
            );

            Console.WriteLine(
                "----------------------------------------------------------"
            );

            foreach (Mahasiswa m in daftarMahasiswa)
            {
                Console.WriteLine(
                    "{0,-12} {1,-20} {2,-20} {3,5:F2}",
                    m.NIM,
                    m.Nama,
                    m.Prodi,
                    m.IPK
                );
            }

            TampilkanGaris();
        }

        static void CariMahasiswa()
        {
            Console.Clear();

            TampilkanGaris();
            Console.WriteLine("         CARI MAHASISWA");
            TampilkanGaris();

            string nimCari;

            while (true)
            {
                Console.Write("Masukkan NIM: ");
                nimCari = Console.ReadLine();

                if (!string.IsNullOrWhiteSpace(nimCari))
                {
                    break;
                }

                Console.WriteLine("NIM tidak boleh kosong.");
            }

            Mahasiswa mahasiswaDitemukan = null;

            foreach (Mahasiswa m in daftarMahasiswa)
            {
                if (m.NIM.Equals(
                    nimCari,
                    StringComparison.OrdinalIgnoreCase))
                {
                    mahasiswaDitemukan = m;
                    break;
                }
            }

            Console.WriteLine();

            if (mahasiswaDitemukan != null)
            {
                Console.WriteLine("Data ditemukan!");
                Console.WriteLine(
                    "NIM   : " + mahasiswaDitemukan.NIM
                );
                Console.WriteLine(
                    "Nama  : " + mahasiswaDitemukan.Nama
                );
                Console.WriteLine(
                    "Prodi : " + mahasiswaDitemukan.Prodi
                );
                Console.WriteLine(
                    "IPK   : " +
                    mahasiswaDitemukan.IPK.ToString("F2")
                );
            }
            else
            {
                Console.WriteLine(
                    "Mahasiswa dengan NIM tersebut tidak ditemukan."
                );
            }
        }

        static void HapusMahasiswa()
        {
            Console.Clear();

            TampilkanGaris();
            Console.WriteLine("        HAPUS MAHASISWA");
            TampilkanGaris();

            string nimHapus;

            while (true)
            {
                Console.Write("Masukkan NIM: ");
                nimHapus = Console.ReadLine();

                if (!string.IsNullOrWhiteSpace(nimHapus))
                {
                    break;
                }

                Console.WriteLine("NIM tidak boleh kosong.");
            }

            Mahasiswa mahasiswaDitemukan = null;

            foreach (Mahasiswa m in daftarMahasiswa)
            {
                if (m.NIM.Equals(
                    nimHapus,
                    StringComparison.OrdinalIgnoreCase))
                {
                    mahasiswaDitemukan = m;
                    break;
                }
            }

            if (mahasiswaDitemukan != null)
            {
                daftarMahasiswa.Remove(
                    mahasiswaDitemukan
                );

                Console.WriteLine();
                Console.WriteLine(
                    "Data mahasiswa berhasil dihapus."
                );
            }
            else
            {
                Console.WriteLine();
                Console.WriteLine(
                    "Data mahasiswa tidak ditemukan."
                );
            }
        }
    }
}
